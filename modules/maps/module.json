{
  "id": "maps",
  "name": "Maps",
  "version": "0.6.1",
  "icon": "map-location-dot",
  "description": "A map of every place your room has: the places you have saved and the items other modules put somewhere. Pick a spot to save a new place.",
  "author": "Coffee Pub",
  "scope": [
    "room"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "panel": {
      "entry": "panel.html",
      "width": 520,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the map and its places",
      "default": {
        "user": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Save places from the map and put items on it",
      "default": {
        "user": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "settings": [
    {
      "key": "map",
      "label": "Map files",
      "type": "files",
      "folder": "map-tiles",
      "scope": "server",
      "default": [],
      "help": "PMTiles map files in modules/maps/map-tiles/ in the data folder. Tick the ones to use; several regions are drawn together."
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "actions": {
    "provides": [
      {
        "name": "showOnMap",
        "label": "Show on the map",
        "local": true,
        "input": {
          "ref": "ref"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "refs": {
    "consumes": [
      "*"
    ]
  },
  "requires": [
    "places"
  ]
}

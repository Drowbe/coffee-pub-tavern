{
  "id": "travel",
  "name": "Planner",
  "version": "0.7.32",
  "icon": "suitcase-rolling",
  "description": "Plan together: a day-by-day itinerary that draws in the events, tasks and polls your space already has.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "panel": {
      "entry": "panel.html",
      "width": 460,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    },
    "widget": {
      "entry": "widget.html",
      "title": "Trips",
      "size": "small",
      "order": 40
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the trip",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Plan the trip: add, change and move things on it",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "events": {
    "subscribes": [
      "*"
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "addStop",
        "label": "Add it to the trip",
        "input": {
          "title": "string",
          "date": "date?",
          "notes": "text?",
          "ref": "ref?"
        }
      },
      {
        "name": "addToDay",
        "label": "Put it on the trip's itinerary",
        "input": {
          "item": "ref",
          "date": "date?"
        }
      },
      {
        "name": "acceptSuggestion",
        "label": "Add it to the trip, properly typed",
        "input": {
          "title": "string",
          "kind": "string?",
          "content": "text?",
          "place": "string?",
          "date": "date?"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "trip",
        "name": "Trip",
        "open": true,
        "backlinks": true,
        "key": "trip:{id}",
        "card": {
          "title": "title",
          "subtitle": "destination",
          "when": "start",
          "end": "end"
        }
      },
      {
        "kind": "plan",
        "name": "Trip item",
        "open": true,
        "backlinks": true,
        "key": "item:{id}",
        "card": {
          "title": "title",
          "subtitle": "place",
          "when": "date",
          "done": "done"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "settings": [
    {
      "key": "markers",
      "label": "Markers",
      "type": "list",
      "scope": "environment",
      "maxLength": 30,
      "fixed": [
        "planning-start",
        "planning-end",
        "trip-start",
        "trip-end"
      ],
      "help": "The markers a plan draws: the four automatic ones (their label, icon and colour can change), and the ones people add -- on a day at a time (a time block, such as free time), on a whole day (a tag in its header, such as a travel day), or on the line between days.",
      "default": [
        {
          "id": "planning-start",
          "label": "Planning starts",
          "icon": "flag",
          "color": "#3b82f6"
        },
        {
          "id": "planning-end",
          "label": "Planning ends",
          "icon": "flag-checkered",
          "color": "#8b5cf6"
        },
        {
          "id": "trip-start",
          "label": "Trip starts",
          "icon": "plane-departure",
          "color": "#22c55e"
        },
        {
          "id": "trip-end",
          "label": "Trip ends",
          "icon": "plane-arrival",
          "color": "#f97316"
        },
        {
          "id": "free-time",
          "label": "Free time",
          "icon": "face-smile",
          "color": "#14b8a6"
        },
        {
          "id": "rest",
          "label": "Rest",
          "icon": "moon",
          "color": "#6366f1"
        },
        {
          "id": "buffer",
          "label": "Buffer",
          "icon": "hourglass-half",
          "color": "#a3a3a3"
        },
        {
          "id": "meet-up",
          "label": "Meet-up",
          "icon": "users",
          "color": "#ec4899"
        },
        {
          "id": "leave-by",
          "label": "Leave by",
          "icon": "clock",
          "color": "#eab308"
        },
        {
          "id": "travel-day",
          "label": "Travel day",
          "icon": "suitcase-rolling",
          "color": "#0ea5e9"
        },
        {
          "id": "free-day",
          "label": "Free day",
          "icon": "sun",
          "color": "#f59e0b"
        }
      ]
    }
  ]
}

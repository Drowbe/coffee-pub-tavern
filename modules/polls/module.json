{
  "id": "polls",
  "name": "Polls",
  "version": "1.9.1",
  "icon": "square-poll-vertical",
  "description": "Quick polls and votes for the whole server and for each room, with live results.",
  "author": "Coffee Pub",
  "scope": ["server", "room"],
  "surfaces": {
    "page": { "entry": "page.html" },
    "panel": { "entry": "panel.html", "width": 380, "height": 560, "mode": ["dock", "float"] }
  },
  "permissions": [
    { "key": "view", "label": "See polls and their results", "default": { "user": true, "guest": true, "moderator": true } },
    { "key": "vote", "label": "Vote in polls", "default": { "user": true, "guest": false, "moderator": true } },
    { "key": "create", "label": "Start, close and delete polls", "default": { "user": true, "guest": false, "moderator": true } }
  ],
  "access": { "read": "view", "write": "vote" },
  "hooks": { "notify": true },
  "events": {
    "publishes": [{ "name": "closed", "kind": "poll", "label": "A poll closed", "data": { "summary": "string", "winner": "string?", "pick": "ref?", "date": "date?" } }]
  },
  "actions": { "uses": ["*"] },
  "refs": {
    "produces": [
      { "kind": "poll", "name": "Poll", "open": true, "backlinks": true, "key": "poll:{id}", "card": { "title": "question", "when": "closesAt" } }
    ],
    "consumes": ["*"]
  }
}

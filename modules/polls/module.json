{
  "id": "polls",
  "name": "Polls",
  "version": "1.12.15",
  "icon": "square-poll-vertical",
  "description": "Quick polls and votes for the whole {environment} and for each {space}, with live results.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 380,
      "height": 560,
      "mode": [
        "dock",
        "float"
      ]
    },
    "widget": {
      "entry": "widget.html",
      "title": "Need your vote",
      "size": "small",
      "order": 30
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See polls and their results",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "vote",
      "label": "Vote in polls",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    },
    {
      "key": "create",
      "label": "Start, close and delete polls",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    },
    {
      "key": "manage_any",
      "label": "Close and delete polls other people started",
      "default": {
        "member": false,
        "guest": false,
        "moderator": false
      }
    }
  ],
  "settings": [
    {
      "key": "addableByDefault",
      "label": "Let people suggest options by default",
      "type": "boolean",
      "scope": "space",
      "default": false,
      "help": "New polls in this {space} start with \"let people add options\" ticked."
    },
    {
      "key": "closeAfterDays",
      "label": "Close new polls after this many days",
      "type": "number",
      "scope": "environment",
      "default": 0,
      "min": 0,
      "max": 60,
      "help": "0 means a new poll stays open until someone closes it. Each poll can still be changed when it is started."
    }
  ],
  "access": {
    "read": "view",
    "write": "vote"
  },
  "hooks": {
    "notify": true
  },
  "events": {
    "publishes": [
      {
        "name": "closed",
        "kind": "poll",
        "label": "A poll closed",
        "data": {
          "summary": "string",
          "winner": "string?",
          "pick": "ref?",
          "date": "date?"
        }
      }
    ]
  },
  "actions": {
    "uses": [
      "*"
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "poll",
        "name": "Poll",
        "open": true,
        "backlinks": true,
        "key": "poll:{id}",
        "summary": {
          "title": "question",
          "when": "closesAt"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  }
}

{
  "id": "places",
  "name": "Places",
  "version": "0.5.0",
  "icon": "location-dot",
  "description": "The places your room cares about: where to stay, where to eat, what to see. Other modules link to them, and a place with a position shows on the map.",
  "author": "Coffee Pub",
  "scope": [
    "room",
    "person"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "panel": {
      "entry": "panel.html",
      "width": 460,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See places",
      "default": {
        "user": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add, change and remove places",
      "default": {
        "user": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "actions": {
    "provides": [
      {
        "name": "addPlace",
        "label": "Save it as a place",
        "input": {
          "title": "string",
          "lat": "number?",
          "lng": "number?",
          "address": "string?",
          "category": "string?",
          "notes": "text?",
          "ref": "ref?"
        }
      },
      {
        "name": "setPlacePoint",
        "label": "Give a place a position",
        "input": {
          "place": "ref:places:place",
          "lat": "number",
          "lng": "number"
        }
      },
      {
        "name": "searchPlaces",
        "label": "Search for a place",
        "local": true,
        "input": {
          "q": "string",
          "lat": "number?",
          "lon": "number?"
        }
      },
      {
        "name": "newPlace",
        "label": "Save a place here",
        "local": true,
        "input": {
          "title": "string?",
          "lat": "number?",
          "lng": "number?",
          "address": "string?",
          "notes": "text?"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "place",
        "name": "Place",
        "open": true,
        "backlinks": true,
        "key": "place:{id}",
        "card": {
          "title": "title",
          "subtitle": "address",
          "place": "point",
          "category": "category"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "settings": [
    {
      "key": "search",
      "label": "Search address",
      "type": "url",
      "scope": "server",
      "default": "",
      "help": "Optional. The address of a Photon-compatible place search that you run or may use, over https (for example https://search.example.org/api). Leave it empty for no search."
    }
  ]
}

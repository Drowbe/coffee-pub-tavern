{
  "id": "places",
  "name": "Places",
  "version": "0.8.5",
  "icon": "location-dot",
  "description": "The places your room cares about: where to stay, where to eat, what to see. Other modules link to them, and a place with a position shows on the map.",
  "author": "Coffee Pub",
  "scope": [
    "server",
    "room",
    "person"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html",
      "nav": false
    },
    "panel": {
      "entry": "panel.html",
      "width": 460,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See places",
      "default": {
        "user": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add, change and remove places",
      "default": {
        "user": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "actions": {
    "provides": [
      {
        "name": "addPlace",
        "label": "Save it as a place",
        "input": {
          "title": "string",
          "lat": "number?",
          "lng": "number?",
          "address": "string?",
          "category": "string?",
          "notes": "text?",
          "ref": "ref?"
        }
      },
      {
        "name": "setPlacePoint",
        "label": "Give a place a position",
        "input": {
          "place": "ref:places:place",
          "lat": "number",
          "lng": "number"
        }
      },
      {
        "name": "searchPlaces",
        "label": "Search for a place",
        "local": true,
        "input": {
          "q": "string",
          "lat": "number?",
          "lon": "number?"
        }
      },
      {
        "name": "newPlace",
        "label": "Save a place here",
        "local": true,
        "input": {
          "origin": "string?",
          "title": "string?",
          "lat": "number?",
          "lng": "number?",
          "address": "string?",
          "notes": "text?"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "place",
        "name": "Place",
        "open": true,
        "backlinks": true,
        "key": "place:{id}",
        "card": {
          "title": "title",
          "subtitle": "address",
          "place": "point",
          "category": "category"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "geocoder": {
    "provider": "searchProvider",
    "address": "search",
    "save": "saveResults",
    "custom": "custom",
    "providers": {
      "photon": {
        "name": "Photon",
        "address": "https://photon.komoot.io/api",
        "credit": "Search by Photon · © OpenStreetMap contributors"
      }
    }
  },
  "settings": [
    {
      "key": "searchProvider",
      "label": "Place search",
      "type": "choice",
      "scope": "server",
      "default": "none",
      "defaultIfSet": {
        "key": "search",
        "value": "custom"
      },
      "help": "Where a search for a place by name is asked. Tavern sends nothing out unless you choose one.",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "photon",
          "label": "Photon, the public service",
          "help": "Every search is sent to the public Photon service at photon.komoot.io, and Tavern otherwise sends nothing out.\nTheir terms are \"reasonable limits\": extensive use may be throttled or banned, and there is no availability guarantee (https://github.com/komoot/photon).\nResults come from OpenStreetMap data, so \"© OpenStreetMap contributors\" applies (Tavern already shows that credit on the map)."
        },
        {
          "value": "custom",
          "label": "My own address",
          "help": "Searches go to the address you give below: a Photon-compatible service you run or may use."
        }
      ]
    },
    {
      "key": "search",
      "label": "Search address",
      "type": "url",
      "scope": "server",
      "default": "",
      "showWhen": {
        "key": "searchProvider",
        "value": "custom"
      },
      "help": "A Photon-compatible place search that you run or may use, over https (for example https://search.example.org/api)."
    },
    {
      "key": "saveResults",
      "label": "Save places to the server",
      "type": "boolean",
      "scope": "server",
      "default": false,
      "showWhen": {
        "key": "searchProvider",
        "not": "none"
      },
      "help": "Places a search returns are saved on this server and shared by every room, so later searches use them first and the outside service is asked less. Only the place is kept, never who looked for it."
    }
  ]
}

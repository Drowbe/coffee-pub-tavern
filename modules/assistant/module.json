{
  "id": "assistant",
  "name": "Assistant",
  "version": "0.1.21",
  "icon": "wand-magic-sparkles",
  "description": "Ask the AI from Chat with /ai. This {module} has no window of its own.",
  "author": "Coffee Pub",
  "scope": [
    "space"
  ],
  "surfaces": {
    "canvas": {
      "entry": "canvas.html",
      "width": 420,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ],
      "menu": false
    }
  },
  "permissions": [
    {
      "key": "use",
      "label": "Use the assistant",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "use",
    "write": "use"
  },
  "hooks": {
    "ai": true
  },
  "refs": {
    "consumes": [
      "*"
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "askAssistant",
        "label": "Ask the assistant",
        "local": true,
        "input": {
          "ref": "ref?",
          "question": "string?"
        }
      }
    ],
    "uses": [
      "*"
    ]
  }
}

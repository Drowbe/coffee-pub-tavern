{
  "id": "todo",
  "name": "To-do",
  "version": "1.11.9",
  "icon": "list-check",
  "description": "A shared to-do list for the whole environment and for each space, with due dates and reminders.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "panel": {
      "entry": "panel.html",
      "width": 380,
      "height": 540,
      "mode": [
        "dock",
        "float"
      ]
    },
    "widget": {
      "entry": "widget.html",
      "title": "Due soon",
      "size": "small",
      "order": 20
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the to-do list",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add, change and tick off tasks",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "hooks": {
    "schedule": true,
    "notify": true
  },
  "events": {
    "subscribes": [
      "*"
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "createTask",
        "label": "Add a task",
        "input": {
          "title": "string",
          "notes": "text?",
          "ref": "ref?"
        }
      },
      {
        "name": "linkTask",
        "label": "Link this task to it",
        "input": {
          "task": "ref:todo:task",
          "target": "ref"
        }
      },
      {
        "name": "setTaskDue",
        "label": "Set this task's due date to its date",
        "input": {
          "task": "ref:todo:task",
          "date": "date"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "task",
        "name": "Task",
        "open": true,
        "key": "task:{id}",
        "card": {
          "title": "title",
          "subtitle": "notes",
          "when": "due",
          "done": "done"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  }
}

# Copy to .env and fill in. Never commit .env.

# Public hostnames (create both as proxy hosts in Nginx Proxy Manager, with TLS).
TAVERN_HOST=tavern.coffeepub.live
LIVEKIT_HOST=livekit.coffeepub.live

# LiveKit API key and secret. Generate with: openssl rand -hex 16 (key) and
# openssl rand -hex 32 (secret). The same pair goes into livekit.yaml.
LIVEKIT_API_KEY=changeme-key
LIVEKIT_API_SECRET=changeme-secret

# Shared key players need in their link until per-player links land (stage 4).
TAVERN_JOIN_KEY=changeme-join

# Streamer key for admin actions.
TAVERN_ADMIN_KEY=changeme-admin

# Port the Tavern app listens on inside the container (published to the host).
PORT=3000
